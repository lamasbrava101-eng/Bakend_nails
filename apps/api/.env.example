NODE_ENV=development
PORT=3000

# Seguridad (cambia en producción)
JWT_SECRET=change-me-in-production-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
BCRYPT_ROUNDS=10

# CORS: incluye la URL pública del frontend (Vercel/Netlify). Separa por comas.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Cookies (producción con frontend y API en dominios distintos: Secure + SameSite=None)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# Proxy (Render/Railway: true)
TRUST_PROXY=false

# Persistencia de datos (citas, comprobantes, inventario, bitácora, config)
DATA_DIR=./data
# PERSISTENCE_ENABLED=true

# (Opcional, futuro Prisma/MySQL)
# DATABASE_URL=mysql://user:password@host:3306/nailstudio